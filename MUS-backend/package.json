{
  "name": "mus-backend",
  "version": "1.0.0",
  "description": "MUS Backend API",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon index.js",
    "start": "cross-env PORT=5001 node index.js",
    "lint": "eslint .",
    "test:smoke:routes": "node --check index.js && node --check src/routes/index.js && node --check src/app.js",
    "test:smoke:membership": "node scripts/testMembershipDownloadAccess.js",
    "test:smoke:favorites": "node scripts/testFavoritesRoleAccess.js",
    "test:smoke:qa": "node scripts/qa-e2e-check.mjs",
    "test:smoke:confusion": "node scripts/confusion-e2e-check.mjs",
    "test:smoke": "npm run test:smoke:routes",
    "test:smoke:api": "npm run test:smoke:favorites && npm run test:smoke:membership",
    "test:e2e": "npm run test:smoke:qa && npm run test:smoke:confusion",
    "test": "npm run test:smoke"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.879.0",
    "@aws-sdk/s3-request-presigner": "^3.879.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "cross-env": "^10.1.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.1",
    "express-validator": "^7.3.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.0",
    "nodemailer": "^8.0.1",
    "pg": "^8.16.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.7",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "nodemon": "^3.1.11"
  }
}
