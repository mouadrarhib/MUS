# =========================
# Required for Railway
# =========================

# Application
NODE_ENV=production
JWT_SECRET=replace_with_strong_secret

# Database (preferred on Railway)
DATABASE_URL=postgresql://user:password@host:5432/database

# CORS (comma-separated)
ALLOWED_ORIGINS=https://your-frontend.up.railway.app

# =========================
# Optional fallback database vars
# Used only when DATABASE_URL is not set
# =========================
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432

# Alternate PostgreSQL aliases supported by code
PGDATABASE=
PGUSER=
PGPASSWORD=
PGHOST=
PGPORT=5432

# Legacy CORS var (still supported)
CLIENT_ORIGIN=

# =========================
# Optional with defaults
# =========================

# Server
PORT=5000
JWT_EXPIRES_IN=1h

# Rate limiting
RATE_LIMIT_PUBLIC_PER_MIN=100
RATE_LIMIT_AUTH_PER_15MIN=5
RATE_LIMIT_REGISTER_PER_HOUR=3
RATE_LIMIT_FORGOT_PER_HOUR=3

# Notification retry worker
NOTIFICATION_RETRY_ENABLED=true
NOTIFICATION_RETRY_INTERVAL_MS=30000
NOTIFICATION_RETRY_RUN_ON_START=true
NOTIFICATION_RETRY_BATCH_SIZE=25
NOTIFICATION_RETRY_MAX_ATTEMPTS=5
NOTIFICATION_RETRY_BASE_DELAY_SECONDS=60

# =========================
# Optional feature-based vars
# Set these only if you use the related feature
# =========================

# Cloudflare R2 / S3-compatible storage
R2_S3_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_SIGNED_URL_TTL_SECONDS=900
R2_PUBLIC_BASE_URL=

# SMTP email notifications
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Push gateway notifications
PUSH_GATEWAY_URL=
PUSH_GATEWAY_TOKEN=

# Google OAuth (required for Google Sign-In)
GOOGLE_CLIENT_ID=
